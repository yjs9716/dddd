/*--------------------------------*- C++ -*----------------------------------*\
  연습 케이스: 직선 유로 냉각판 (OpenFOAM ESI v2412 기준)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "$FOAM_CASE/constant/caseParams"

dimensions      [0 0 0 1 0 0 0];

internalField   uniform $T_in;

boundaryField
{
    ".*"                        // 외부면: 단열 (연습용 단순화)
    {
        type            zeroGradient;
    }
    heater                      // 발열 패드: 총 발열량 [W] 지정
    {
        type            externalWallHeatFluxTemperature;
        mode            power;
        Q               $Q_heater;
        kappaMethod     solidThermo;
        value           uniform $T_in;
    }
    solid_to_fluid
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform $T_in;
    }
}
